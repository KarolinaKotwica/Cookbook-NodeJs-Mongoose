<%- include('partials/header'); -%>
<title>Pyszne, sprawdzone przepisy - Cookbook</title>
<meta name="description" content="Sprawdź nasze przepisy na polskie dania - szybkie, łatwe i pyszne. Znajdziesz u nas wiele pomysłów na obiad oraz inne pyszne przepisy. Odkryj nasze szybkie przepisy na dania z mięsa, ryby i wiele innych pyszności. Nie czekaj, zobacz sam!">
</head>

<body id="google_translate_element">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KDZ84VJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
<%- include('partials/nav'); -%>

<!-- ===== HERO ===== -->
<div id="main_background">
    <div id="main_banner">
        <span class="hero-tag"><i class="fas fa-utensils"></i> Kuchnia domowa</span>
        <h2 id="welcome">Witaj na cookbook.com.pl</h2>
        <p>Szukasz nowych pomysłów na pyszne i zdrowe posiłki? Znajdziesz tu wiele sprawdzonych przepisów, praktycznych porad i inspiracji kulinarnych.</p>
        <p><a href="/login"><span class="color">Zaloguj się</span></a>, aby dodawać przepisy, tworzyć listy zakupów i zapisywać ulubione dania!</p>
        <div class="hero-cta">
            <a href="/wszystkie-przepisy/1" class="hero-btn-primary">Przeglądaj przepisy <i class="fas fa-arrow-right"></i></a>
            <a href="/login" class="hero-btn-secondary">Dodaj przepis</a>
        </div>
    </div>
    <div class="hero-image-col">
        <div class="hero-image-wrap">
            <img src="/imgs/schabowy z ziemniakami.jpg" alt="Pyszne polskie przepisy">
            <div class="hero-badge">
                <i class="fas fa-check-circle"></i><br>Sprawdzone<br>przepisy
            </div>
        </div>
    </div>
</div>

<!-- ===== CATEGORIES CHIPS ===== -->
<div class="categories-section">
    <div class="categories-header">
        <h2>Kategorie przepisów</h2>
        <a href="/wszystkie-przepisy/1" class="view-all-link">Wszystkie przepisy →</a>
    </div>
    <div class="category-chips-row">
        <a href="/wszystkie-przepisy/1" class="category-chip">🍽 Wszystkie</a>
        <a href="/obiad" class="category-chip">🥩 Obiad</a>
        <a href="/desery" class="category-chip">🍰 Desery</a>
        <a href="/torty" class="category-chip">🎂 Torty</a>
        <a href="/dla-dzieci" class="category-chip">👶 Dzieci</a>
        <a href="/dodatki" class="category-chip">🥗 Dodatki</a>
        <a href="/salatki" class="category-chip">🥗 Sałatki</a>
        <a href="/zupy" class="category-chip">🍲 Zupy</a>
        <a href="/przekaski" class="category-chip">🥨 Przekąski</a>
        <a href="/sniadanie" class="category-chip">🍳 Śniadanie</a>
    </div>
</div>

<!-- ===== PRZEPIS DNIA ===== -->
<div class="home-sections">
    <div class="daily-recipe-section">
        <h2>Przepis dnia</h2>
        <a href="/przepisy/<%= random._id %>" class="daily-recipe-card">
            <div class="daily-recipe-img">
                <img src="https://img-store223.s3.amazonaws.com/<%= random.image %>"
                     alt="<%= random.title %>" loading="lazy">
            </div>
            <div class="daily-recipe-info">
                <span class="recipe-category-badge"><%= random.category %></span>
                <h3 class="daily-recipe-title"><%= random.title %></h3>
                <div class="daily-recipe-meta">
                    <span>⏱ <%= random.time %> min</span>
                    <span><i class="fas fa-user"></i> <%= random.publisher %></span>
                </div>
                <span class="daily-recipe-cta">Zobacz przepis →</span>
            </div>
        </a>
    </div>
</div>

<!-- ===== OSTATNIE PRZEPISY ===== -->
<div class="recipes_container latest_container">
    <h2>Ostatnio dodane przepisy</h2>
    <div class="all">
        <p>Wszystkie przepisy → <a href="/wszystkie-przepisy/1">kliknij tutaj</a></p>
    </div>
    <%- include('partials/recipe'); -%>
    <div class="all">
        <p>
            Jeśli nie znalazłeś tego czego szukasz, sprawdź
            <a href="/wszystkie-przepisy/1">pełną listę przepisów</a>
            — znajdziesz tam wiele różnych potraw, od szybkich dań po wykwintne specjały.
        </p>
    </div>
</div>

<%- include('partials/footer_newsletter'); -%>
<%- include('partials/footer'); -%>
