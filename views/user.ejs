<%- include('partials/header'); -%>
<title>Konto użytkownika - Cookbook</title>
<meta name="description" content="Konto użytkownika">
</head>
<body id="google_translate_element">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KDZ84VJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
<%- include('partials/nav'); -%>

<div class="wrapper">
    <section class="sidebar">
        <img src="/imgs/chef.png" alt="logo użytkownika">
        <h3>Witaj, <%= user.username %></h3>
        <span class="user_icons">
            <a href="/favoriteUser" title="Ulubione"><i class="fas fa-heart"></i></a>
            <a href="/add" title="Dodaj przepis"><i class="fas fa-plus-circle"></i></a>
            <a href="/shopList" title="Lista zakupów"><i class="fas fa-cart-plus"></i></a>
            <a href="/planer" title="Planer"><i class="fas fa-calendar-check"></i></a>
        </span>
        <p>
            W swojej książce masz już:
            <strong class="color"><%= user.recipes.length %>
            <% if (user.recipes.length === 1) { %>
                przepis
            <% } else if (user.recipes.length > 1 && user.recipes.length < 5) { %>
                przepisy
            <% } else { %>
                przepisów
            <% } %>
            </strong>
        </p>
        <% if (user.recipes.length === 0) { %>
            <p>Możesz dodać pierwszy przepis tutaj:<br>
                <a class="add_button" href="/add">Dodaj przepis</a>
            </p>
        <% } %>
        <% if (user.favorite.length === 0) { %>
            <p>Nie masz jeszcze ulubionych przepisów.</p>
        <% } %>
        <br>
        <a href="/logout">Wyloguj</a>
    </section>

    <section class="recipes_container cookbook">
        <h2 style="text-align:left; padding: 0.5rem 0 0.25rem;">Moje przepisy</h2>

        <!-- Category filter chips -->
        <div class="category-filters">
            <button class="category-filter-btn active" data-filter="all">Wszystkie (<%= userRecipe.length %>)</button>
            <% const categories = ['Obiad','Desery','Torty','Dla dzieci','Dodatki','Sałatki','Zupy','Przekąski','Śniadanie']; %>
            <% categories.forEach(function(cat) { %>
                <% const count = userRecipe.filter(r => r.category === cat).length; %>
                <% if (count > 0) { %>
                    <button class="category-filter-btn" data-filter="<%= cat %>"><%= cat %> (<%= count %>)</button>
                <% } %>
            <% }); %>
        </div>

        <!-- All recipes in one grid -->
        <div class="recipes" id="userRecipesGrid">
            <% if (userRecipe.length === 0) { %>
                <p style="padding: 2em; color: var(--text-muted);">Nie masz jeszcze żadnych przepisów. <a href="/add">Dodaj pierwszy!</a></p>
            <% } %>
            <% userRecipe.forEach(function(recipe) { %>
            <div class="card recipe-card-item" data-category="<%= recipe.category %>">
                <a href="/przepisy/<%= recipe._id %>">
                    <img src="https://img-store223.s3.amazonaws.com/<%= recipe.image %>"
                         class="card-img-top"
                         alt="<%= recipe.title %>"
                         loading="lazy">
                    <div class="card-body">
                        <h4><%= recipe.title %></h4>
                        <span class="recipe-category-badge"><%= recipe.category %></span>
                    </div>
                </a>
                <div class="overall_buttons">
                    <a href="/edit/<%= recipe._id %>" class="edit-btn">
                        <i class="fas fa-user-edit"></i> Edytuj
                    </a>
                </div>
            </div>
            <% }); %>
        </div>
    </section>
</div>

<%- include('partials/footer'); -%>
