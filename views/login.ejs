<%- include('partials/header'); -%>
<title>Zaloguj się lub załóż nowe konto - Cookbook</title>
<meta name="description" content="Zaloguj się i zacznij dodawać swoje własne przepisy. Będziesz mieć również dostęp do listy zakupów, planera i ulubionych przepisów!">
</head>
<body id="google_translate_element">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KDZ84VJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
<%- include('partials/nav'); -%>

<div class="login-page">
  <div class="container">
    <div class="login-wrapper">

      <!-- LOGIN -->
      <div class="auth-card">
        <h2>Zaloguj się</h2>
        <p class="auth-subtitle">Witaj z powrotem!</p>

        <% if (userName.length > 0) { %>
          <div class="alert alert-danger" role="alert"><%= userName %></div>
        <% } %>

        <form role="form" method="post" action="/login">
          <fieldset>
            <div class="mb-3">
              <input type="text" name="username" class="form-control" placeholder="Nazwa użytkownika" autocomplete="username">
            </div>
            <div class="mb-3">
              <input type="password" name="password" class="form-control" placeholder="Hasło" autocomplete="current-password">
            </div>
            <button type="submit" class="auth-btn">Zaloguj</button>
          </fieldset>
        </form>
      </div>

      <!-- REGISTER -->
      <div class="auth-card">
        <h2>Nowe konto</h2>
        <p class="auth-subtitle">Dołącz do Cookbook!</p>

        <% if (registrations.length > 0) { %>
          <div class="alert alert-danger" role="alert"><%= registrations %></div>
        <% } %>
        <% if (registrations_error_username.length > 0) { %>
          <div class="alert alert-danger" role="alert"><%= registrations_error_username %></div>
        <% } %>

        <form role="form" method="post" action="/register">
          <fieldset>
            <div class="mb-3">
              <input type="text" name="username" id="username" class="form-control" autocomplete="off" placeholder="Nazwa użytkownika">
            </div>
            <div class="mb-3">
              <input type="email" name="email" id="email" class="form-control" placeholder="Email">
            </div>
            <div class="mb-3">
              <input type="password" name="password" id="password" class="form-control" autocomplete="off" placeholder="Hasło">
            </div>
            <div class="center mb-3">
              <div class="h-captcha" data-sitekey="43baed29-4dd8-4240-9543-185a95abee75"></div>
            </div>
            <button type="submit" class="auth-btn">Zarejestruj</button>
          </fieldset>
        </form>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer'); -%>
